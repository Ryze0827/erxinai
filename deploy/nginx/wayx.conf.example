# Replace the domain, certificate paths, root, and backend target before enabling this file.
upstream wayx_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name wayx.example.com;
    return 301 https://wayx.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wayx.example.com;

    ssl_certificate /etc/letsencrypt/live/wayx.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wayx.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:wayx_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /srv/wayx/dist;
    index index.html;
    client_max_body_size 20m;

    include /srv/wayx/deploy/nginx/security-headers.conf;

    location ~ ^/(?:api|v1)/ {
        proxy_pass http://wayx_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|mjs|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$ {
        try_files $uri =404;
        expires 30d;
        access_log off;
    }

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
}
