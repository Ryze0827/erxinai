VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=https://aiwxin.com
VITE_DEV_IMAGE_PROXY_TARGET=https://image.aiwayxx.com
VITE_DASHBOARD_URL=/dashboard

# FlowPool base URL for invoice APIs. Empty uses the same-origin reverse proxy.
# Use https://flowpool.example.com in production, without /api/invoice-user.
VITE_FLOWPOOL_BASE_URL=
# Used only when VITE_FLOWPOOL_BASE_URL is empty in development.
VITE_DEV_INVOICE_PROXY_TARGET=http://127.0.0.1:8765
